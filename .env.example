# ============================================================
#  UnblockNeteaseMusic 3.x 适配版 - 配置文件
#  改完保存，重启服务生效（config.bat 里可以直接重启）
#  优先级: 系统环境变量 > 本文件
# ============================================================

# ---------- 本地 VIP（客户端内伪装黑胶） ----------
# 可选: true (=cvip) / cvip / svip
# 关闭就整行注释掉
ENABLE_LOCAL_VIP=svip

# 只对指定 UID 生效，逗号分隔。留空 = 所有登录账号都生效
# LOCAL_VIP_UID=123456789,987654321

# ---------- 音质 ----------
# 优先无损音源（FLAC），会让换源更慢但音质更好
ENABLE_FLAC=true

# 最低可接受码率，低于该值一律换源。留空 = 不限制
# 320000 = 320kbps，999000 = 无损
# MIN_BR=

# 在所有音源里挑码率最高的那个（最慢但最好）
# SELECT_MAX_BR=true

# 严格按 -o 指定的音源顺序查，不并发竞速
# FOLLOW_SOURCE_ORDER=true

# 搜索时带上专辑名，提高匹配准确率（对外文歌有效）
# SEARCH_ALBUM=true

# ---------- 音源 ----------
# 音源顺序（逗号分隔）。注释掉 = 内置默认 kugou,kuwo,migu,bilibili,ytdlp
# 想彻底不用 B站就填: kugou,kuwo,migu
MATCH_ORDER=kugou,kuwo,migu

# ---------- 客户端行为 ----------
# 屏蔽应用内部分广告
BLOCK_ADS=true

# 禁用客户端更新检测（避免更新后又跑不上）
DISABLE_UPGRADE_CHECK=true

# ---------- 日志 ----------
# trace / debug / info / warn / error
# 排障时用 debug，能看到 eapi 明文和换源明细
LOG_LEVEL=info

# 日志写入文件（默认输出到控制台）
# LOG_FILE=unm.log

# JSON 格式日志（给日志系统用，人看不建议开）
# JSON_LOG=true

# ---------- 性能 ----------
# 停用缓存，每次都重新请求音源（调试用）
# NO_CACHE=true

# 启用故障的网易 HTTPDNS 查询（不建议）
# ENABLE_HTTPDNS=true

# ---------- 音源凭证（按需填） ----------
# QQ 音乐: 需要 QQ 登录后的 uin 和 qm_keyst
# QQ_COOKIE=uin=123456789; qm_keyst=xxx

# 新版 QQ 音乐
# NEW_QQ_COOKIE=

# 酷我音乐
# KUWO_COOKIE=

# 咪咕音乐: aversionid
# MIGU_COOKIE=

# JOOX: wmid 和 session_key
# JOOX_COOKIE=wmid=xxx; session_key=xxx

# YouTube Data API v3 Key
# YOUTUBE_KEY=

# ---------- 网易账号 ----------
# 用自己的网易云 Cookie 请求播放地址（部分版权歌需要登录态）
# NETEASE_COOKIE=MUSIC_U=xxx; __csrf=xxx

# ---------- 证书 ----------
# 自定义 TLS 证书路径（默认用 exe 内置的 server.crt / server.key）
# SIGN_CERT=./server.crt
# SIGN_KEY=./server.key
